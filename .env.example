# FlatOps local configuration — copy to `.env` and fill in.
# `.env` is git-ignored and never deployed. These values are pushed into the
# bot's private `settings` table by `npm run set-key`.

# --- Required ---

# Your AI provider secret key.
AI_API_KEY=

# Your Telegram numeric user id (send /whoami to the bot). Must be the admin.
ADMIN_TG_ID=

# --- Provider selection ---

# academiccloud | groq | openai | openai_compatible
AI_PROVIDER=academiccloud

# Academic Cloud: only multimodal models can read a receipt photo.
# qwen3-omni-30b-a3b-instruct is the one designed for images.
# Groq alternative: qwen/qwen3.8-27b
# OpenAI alternative: gpt-4o-mini
AI_MODEL=qwen3-omni-30b-a3b-instruct

# Only needed for a custom OpenAI-compatible gateway.
# Academic Cloud is built in, so leave this empty for it.
# Groq:    https://api.groq.com/openai/v1
# OpenAI:  https://api.openai.com/v1
AI_BASE_URL=

# --- Optional ---

# Printed by `npx tgcloud push`; enables the "Review receipt" button.
MINI_APP_URL=
