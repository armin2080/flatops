{
  "name": "flatops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FlatOps — shared living, simplified. Phase 1: smart receipt & expense management on Telegram Serverless.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && tgcloud push",
    "status": "tgcloud status",
    "diff": "tgcloud diff",
    "login": "tgcloud login",
    "migrate": "tgcloud migrate",
    "run:handler": "tgcloud run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tgcloud/cli": "^0.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
